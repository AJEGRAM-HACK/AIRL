# AIRL defaults to local Ollama. Demo mode requires no model or API credentials.
AI_PROVIDER=ollama
# Server gate for paid Hosted OpenAI calls, plus per-operation consent.
AIRL_ALLOW_LIVE_REQUESTS=false
NEXT_PUBLIC_ENABLE_CINEMAI=true
NEXT_PUBLIC_ENABLE_PERSONA=true
NEXT_PUBLIC_ENABLE_AIRL_LIVE=true
NEXT_PUBLIC_ENABLE_QUEST=false
NEXT_PUBLIC_ENABLE_REMIX=false
NEXT_PUBLIC_ENABLE_WORLDS=false
NEXT_PUBLIC_ENABLE_MEMORIES=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
TRIGGER_SECRET_KEY=

# Local production CLI persistence; no database service is provisioned.
# CINEMAI_DB_PATH=

# Shared local community storage, used by the web app and operator CLI.
# AIRL_LIVE_DB_PATH=.data/airl-live.sqlite

# Provider gateway. Supported modes: demo, hosted_openai, creator_byok, ollama.
# Set AI_PROVIDER=demo for offline CLI rehearsals. BYOK uses authenticated HTTPS requests only.
# Select the exact name reported by your local Ollama installation.
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_WINDOW=8192
AIRL_AI_REQUEST_TIMEOUT_MS=110000
AIRL_AI_MAX_OUTPUT_TOKENS=2400
AIRL_AI_DAILY_REQUEST_LIMIT=20
# Optional estimated spend gate. Estimates are not exact billing limits.
AIRL_AI_DAILY_ESTIMATED_USD_LIMIT=
AIRL_AI_REQUEST_RESERVATION_USD=1
# Set rates for the selected paid model to enable estimates.
AIRL_AI_INPUT_USD_PER_MILLION=
AIRL_AI_OUTPUT_USD_PER_MILLION=

# Comma-separated allowed hosted model IDs, configured server-side.
OPENAI_ALLOWED_MODELS=
